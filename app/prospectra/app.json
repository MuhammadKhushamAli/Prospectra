{
  "expo": {
    "name": "prospectra",
    "slug": "prospectra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app_icons/prospectra-light.png",
    "scheme": "prospectra",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/app_icons/prospectra-light.png",
        "dark": "./assets/app_icons/prospectra-dark.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/app_icons/prospectra-foreground.png",
        "monochromeImage": "./assets/app_icons/prospectra-mono.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F2EA",
          "dark": {
            "backgroundColor": "#12130F"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
